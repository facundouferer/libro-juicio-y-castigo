---
/**
 * The cover.
 *
 * A full-bleed photograph of the building itself — the facade of the ex Brigada
 * de Investigaciones — with the title over it. It replaced a generated collage:
 * in a book that reconstructs facts proved in court, the image on the front has
 * to be verifiable (spec 06, RF-06.1). Scrolling
 * past lifts the cover away — the one moment in the book where the page itself
 * moves.
 *
 * The back-cover prose used to sit directly underneath. It is contratapa copy
 * and now closes the book instead (spec 01, RF-01.3).
 */
import { BOOK, withBase } from '../lib/site.mjs';
---

<section class="landing" id="tapa">
  <picture>
    <source
      type="image/avif"
      srcset={`${withBase('/img/tapa-960.avif')} 960w, ${withBase('/img/tapa-1600.avif')} 1600w, ${withBase('/img/tapa-2400.avif')} 2400w`}
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset={`${withBase('/img/tapa-960.webp')} 960w, ${withBase('/img/tapa-1600.webp')} 1600w`}
      sizes="100vw"
    />
    <img
      class="landing-bg"
      src={withBase('/img/tapa-1600.webp')}
      alt=""
      role="presentation"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="landing-inner">
    <img class="landing-logo" src={withBase('/img/logo.webp')} alt="Comisión Provincial por la Memoria — Chaco" width="320" height="118" />
    <h1>
      <span class="hl">{BOOK.title}</span>
      <br />
      <span class="hl">{BOOK.volume}</span>
    </h1>
    <p class="landing-sub">{BOOK.subtitle}</p>
    <p class="landing-sub landing-kicker">{BOOK.kicker}</p>
  </div>
</section>

