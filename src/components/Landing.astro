---
/**
 * The cover.
 *
 * A full-bleed photograph of the building with the title over it, and the
 * back-cover text on the ground below. Scrolling past lifts the cover away —
 * the one moment in the book where the page itself moves.
 */
import { BOOK, withBase } from '../lib/site.mjs';

/** The back-cover prose arrives as the default slot. */
---

<section class="landing" id="tapa">
  <picture>
    <source
      type="image/avif"
      srcset={`${withBase('/img/fondo-tapa-960.avif')} 960w, ${withBase('/img/fondo-tapa-1600.avif')} 1600w, ${withBase('/img/fondo-tapa-2400.avif')} 2400w`}
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset={`${withBase('/img/fondo-tapa-960.webp')} 960w, ${withBase('/img/fondo-tapa-1600.webp')} 1600w`}
      sizes="100vw"
    />
    <img
      class="landing-bg"
      src={withBase('/img/fondo-tapa-1600.webp')}
      alt=""
      role="presentation"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="landing-inner">
    <img class="landing-logo" src={withBase('/img/logo.webp')} alt="Comisión Provincial por la Memoria — Chaco" width="320" height="320" />
    <h1>
      <span class="hl">{BOOK.title}</span>
      <br />
      <span class="hl">{BOOK.volume}</span>
    </h1>
    <p class="landing-sub">{BOOK.subtitle}</p>
    <p class="landing-sub landing-kicker">{BOOK.kicker}</p>
  </div>
</section>

<section class="blurb" id="contratapa">
  <slot />
</section>
