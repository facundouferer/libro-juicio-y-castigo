---
/**
 * The contents panel: every title in the book, grouped by section, over a
 * search field that filters titles as you type and — once you pass three
 * characters — folds in full-text hits from the Pagefind index built at
 * deploy time.
 *
 * The whole tree is rendered server-side, so the panel works with the script
 * still loading and the anchors remain crawlable.
 */
import Icon from './Icon.astro';
import { SECTIONS, ENTRIES } from '../lib/book.mjs';

const bySection = SECTIONS.map((section) => ({
  ...section,
  entries: ENTRIES.filter((e) => e.section === section.id),
})).filter((s) => s.entries.length);

/**
 * What a reader navigates by is the headline of a chronicle, not its volanta.
 *
 * The manuscript writes the volanta as the `h1` and the headline as the `h2`,
 * so the panel listed 34 entries reading «CAUSA BRIGADA I 7 julio 2010» above
 * the titles they introduce. A volanta that has a headline is folded into it;
 * one that opens a chronicle on its own stays, because otherwise that chronicle
 * would have no entry at all (specs-v12, spec 04, RF-04.5).
 */
function navigable(headings) {
  return headings
    .map((heading, i) => {
      if (heading.role !== 'volanta') return heading;
      const next = headings[i + 1];
      return next?.role === 'title' ? null : { ...heading, depth: 2 };
    })
    .filter(Boolean);
}

/** The parts that get a cover of their own (specs-v12, spec 03). */
const partOf = new Map(
  bySection.filter((s) => s.part).map((s) => [s.entries[0]?.slug, s]),
);
---

<dialog class="modal" id="dlg-contents" aria-labelledby="contents-title">
  <div class="modal-panel">
    <header class="modal-head">
      <h2 id="contents-title">Contenido</h2>
      <button class="modal-close" type="button" data-close aria-label="Cerrar el contenido">
        <Icon name="close" size={20} />
      </button>
    </header>

    <div class="contents-search">
      <label class="visually-hidden" for="contents-q">Buscar en el libro</label>
      <input
        class="input"
        type="search"
        id="contents-q"
        placeholder="Buscar un capítulo, un nombre, una fecha…"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <p class="contents-hint" id="contents-hint">
      {ENTRIES.reduce((n, e) => n + navigable(e.headings).length, 0)} títulos. Escribí tres letras o más para buscar
      también dentro del texto.
    </p>

    <nav class="contents-list" id="contents-list" aria-label="Índice del libro">
      {
        bySection.map((section) => (
          <>
            <p class="contents-section" data-section-label={section.id}>
              {section.part ? `${section.part} — ${section.title}` : section.title}
            </p>
            {section.entries.map((entry) => (
              <>
                {partOf.get(entry.slug) && (
                  <a href={`#parte-${section.id}`} data-depth="doc" data-title={section.title}>
                    {section.title}
                  </a>
                )}
                <a href={`#${entry.slug}`} data-depth="doc" data-title={entry.title}>
                  {entry.title}
                </a>
                {navigable(entry.headings).map((heading) => (
                  <a href={`#${heading.slug}`} data-depth={String(heading.depth)} data-title={heading.text}>
                    {heading.text}
                  </a>
                ))}
              </>
            ))}
          </>
        ))
      }
    </nav>

    <div class="contents-list" id="contents-results" hidden aria-live="polite"></div>
  </div>
</dialog>
