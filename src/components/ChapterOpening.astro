---
/**
 * The text that opens a part.
 *
 * It used to share a page with the name of its section, which sat above it as
 * an overline. That arrangement gave the section no cover of its own and made
 * the essay look like the section (specs-v12, spec 03). The section now has
 * `PartCover.astro`; what is left here is an ordinary text with its own title,
 * set wide because these five essays are short and carry the register of the
 * part they open.
 */

interface Props {
  docSlug: string;
  title: string;
  section: string;
  byline?: string;
}

const { docSlug, title, section, byline } = Astro.props;
---

<section class="doc opening is-text" id={docSlug} data-doc={docSlug} data-section={section}>
  <div class="opening-body">
    <h2 class="opening-title" data-pagefind-meta={`title:${title}`}>
      <span class="hl">{title}</span>
    </h2>
    {byline && <p class="doc-byline">{byline}</p>}
    <div class="opening-prose">
      <slot />
    </div>
  </div>
</section>
