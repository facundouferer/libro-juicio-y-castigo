---
/**
 * The book, as one continuous document.
 *
 * Every chapter renders into a single page in reading order, so the reader
 * goes from the cover to the last page of the annex on one scrollbar — which
 * is what makes it read like a book and what makes the reading-position
 * memory mean anything.
 */
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Controls from '../components/Controls.astro';
import ScrollHint from '../components/ScrollHint.astro';
import Landing from '../components/Landing.astro';
import ChapterOpening from '../components/ChapterOpening.astro';
import SplitReader from '../components/SplitReader.astro';
import Interlude from '../components/Interlude.astro';
import Colophon from '../components/Colophon.astro';
import ContentsModal from '../components/ContentsModal.astro';
import DownloadModal from '../components/DownloadModal.astro';
import ZoomModal from '../components/ZoomModal.astro';
import BookFooter from '../components/BookFooter.astro';
import { BOOK } from '../lib/site.mjs';

const entries = (await getCollection('book')).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

/** The cover's body is the back-cover text; it closes the book (spec 01, RF-01.3). */
const cover = rendered.find(({ entry }) => entry.data.pageType === 'landing');
---

<Base title={`${BOOK.title} (${BOOK.volume}) — ${BOOK.subtitle}`} isBook>
  <Controls />
  <ScrollHint />

  <main id="contenido" data-pagefind-body>
    {
      rendered.map(({ entry, Content }) => {
        const props = {
          docSlug: entry.data.docSlug,
          title: entry.data.title,
          section: entry.data.section,
          showTitle: entry.data.showTitle,
          kicker: entry.data.kicker,
        };

        // The cover carries no prose any more: its body is contratapa copy and
        // is rendered at the foot of the book instead (spec 01, RF-01.3).
        if (entry.data.pageType === 'landing') return <Landing />;

        if (entry.data.pageType === 'colophon') {
          return (
            <Colophon {...props}>
              <Content />
            </Colophon>
          );
        }
        if (entry.data.pageType === 'citations') {
          return (
            <Interlude {...props} variant="citations">
              <Content />
            </Interlude>
          );
        }
        if (entry.data.pageType === 'chapter-opening') {
          return (
            <ChapterOpening {...props}>
              <Content />
            </ChapterOpening>
          );
        }
        if (entry.data.pageType === 'interlude') {
          return (
            <Interlude {...props}>
              <Content />
            </Interlude>
          );
        }
        return (
          <SplitReader {...props}>
            <Content />
          </SplitReader>
        );
      })
    }

    {
      cover && (
        <section class="blurb" id="contratapa" aria-label="Sobre este libro">
          <cover.Content />
        </section>
      )
    }

    <BookFooter />
  </main>

  <ContentsModal />
  <DownloadModal />
  <ZoomModal />
</Base>
