# Dependencies
node_modules/

# Astro
dist/
.astro/

# Intermediate build products.
#
# Everything under build/ is derived from src/images/ by scripts/optimize-images.mjs
# and consumed by the PDF and EPUB builds. The finished PDF and EPUB themselves
# are committed under public/descargas/ — they are what the site serves — but
# these 60 MB of intermediates are not worth versioning.
build/

# The Pagefind index is generated by `npm run build` after Astro.
public/pagefind/

# macOS
.DS_Store
**/.DS_Store

# Editors
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
