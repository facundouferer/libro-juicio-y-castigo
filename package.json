{
  "name": "juicio-y-castigo-chaco",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web del libro Juicio y Castigo en el Chaco (Vol II) — Causa Brigada I, II, III",
  "scripts": {
    "normalize": "node scripts/normalize-content.mjs",
    "captions": "node scripts/parse-captions.mjs",
    "map": "node scripts/build-image-map.mjs",
    "images": "node scripts/optimize-images.mjs",
    "revision": "node scripts/report-review.mjs",
    "check": "node scripts/check-build.mjs",
    "pdf": "node scripts/build-pdf.mjs",
    "epub": "node scripts/build-epub.mjs",
    "downloads": "node scripts/build-downloads.mjs",
    "shots": "node scripts/shoot.mjs",
    "prepare:content": "npm run normalize && node scripts/build-heading-index.mjs && npm run captions && npm run map && npm run revision",
    "prepare:downloads": "npm run pdf && npm run epub && npm run downloads",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "astro": "^5.14.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "pagefind": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.62.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.4",
    "unified": "^11.0.5"
  }
}
